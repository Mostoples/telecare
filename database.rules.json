{
  "rules": {
    ".read": false,
    ".write": false,

    "telecare": {

      "live": {
        ".read": true,
        ".write": false
      },

      "demo": {

        "consults": {
          "$consultId": {
            ".read": "auth != null && (!data.exists() || data.child('meta/members').hasChild(auth.uid))",

            "meta": {
              ".write": "auth != null && (!data.exists() || root.child('telecare/demo/consults/' + $consultId + '/meta/members').hasChild(auth.uid))",

              "members": {
                "$uid": {
                  ".write": "auth != null && $uid == auth.uid",
                  ".validate": "newData.isBoolean()"
                }
              },

              "doctorId": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "mode": {
                ".validate": "newData.val() == 'chat' || newData.val() == 'video' || newData.val() == 'audio'"
              },
              "status": {
                ".validate": "newData.val() == 'active' || newData.val() == 'done'"
              },
              "startedAt": {
                ".validate": "newData.isNumber()"
              },
              "doctorOnline": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            },

            "messages": {
              "$messageId": {
                ".write": "auth != null && root.child('telecare/demo/consults/' + $consultId + '/meta/members').hasChild(auth.uid) && !data.exists()",
                ".validate": "newData.hasChildren(['at', 'uid', 'from'])",

                "uid": {
                  ".validate": "newData.val() == auth.uid"
                },
                "from": {
                  ".validate": "newData.val() == 'me' || newData.val() == 'doc' || newData.val() == 'sys'"
                },
                "at": {
                  ".validate": "newData.isNumber()"
                },
                "text": {
                  ".validate": "newData.isString() && newData.val().length <= 2000"
                },
                "mid": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "$other": {
                  ".validate": false
                }
              }
            },

            "$other": {
              ".validate": false
            }
          }
        },

        "rooms": {
          "$roomId": {
            ".read": "auth != null && root.child('telecare/demo/consults/' + $roomId + '/meta/members').hasChild(auth.uid)",
            ".write": "auth != null && root.child('telecare/demo/consults/' + $roomId + '/meta/members').hasChild(auth.uid)",

            "offer": {
              "sdp": {
                ".validate": "newData.isString() && newData.val().length <= 30000"
              },
              "type": {
                ".validate": "newData.val() == 'offer'"
              },
              "$other": {
                ".validate": false
              }
            },
            "answer": {
              "sdp": {
                ".validate": "newData.isString() && newData.val().length <= 30000"
              },
              "type": {
                ".validate": "newData.val() == 'answer'"
              },
              "$other": {
                ".validate": false
              }
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "callerCandidates": {
              "$c": {
                ".validate": "newData.hasChild('candidate') || newData.hasChild('sdpMid')"
              }
            },
            "calleeCandidates": {
              "$c": {
                ".validate": "newData.hasChild('candidate') || newData.hasChild('sdpMid')"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
